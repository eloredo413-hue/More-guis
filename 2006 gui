		apply2006Font(leftLabel)
		local statContainer =
			Instance.new("Frame")
		statContainer.Name =
			"StatContainer"
		statContainer.BackgroundTransparency = 1
		statContainer.Parent =
			rowFrame
		local underline =
			Instance.new("Frame")
