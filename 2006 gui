-- Bubble text is measured with the 2006 font's own letter widths
local function measureText(text)
	local size = FONT_SIZE + 4
	local lines = layout2006Lines(text, size, MAX_TEXT_WIDTH)
	local width = 0
	for _, line in ipairs(lines) do
		width = math.max(width, measure2006Line(line, size))
	end
	return Vector2.new(width, #lines * size)
end

local function wrapText(text)
	return table.concat(layout2006Lines(text, FONT_SIZE + 4, MAX_TEXT_WIDTH), "\n")
end

local function getAnchor(head)
	local attachment = head:FindFirstChild("Retro2009BubbleAnchor")

	if attachment and attachment:IsA("Attachment") then
		attachment.Position = Vector3.new(0, HEAD_OFFSET, 0)
		return attachment
	end

	attachment = Instance.new("Attachment")
	attachment.Name = "Retro2009BubbleAnchor"
	attachment.Position = Vector3.new(0, HEAD_OFFSET, 0)
	attachment.Parent = head

	return attachment
end

local function getStack(head)
	if stacks[head] and stacks[head].gui and stacks[head].gui.Parent then
		return stacks[head]
	end

	local anchor = getAnchor(head)

	local gui = Instance.new("BillboardGui")
