local function getClassicUIScale()
	local viewport = Camera.ViewportSize
	if viewport.Y < 800
		or viewport.X < 1200 then
		return math.clamp(
			viewport.Y / 900,
			0.55,
			1
		)
	end
	return 1
end
-- 2006 letters are TextSize + 4 tall, so sizes scaled by hand keep that + 4 in proportion
local function scaleTextSize(textSize, scale)
	return (textSize + 4) * scale - 4
end
