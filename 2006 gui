local function updatePlayerList()
	updateHeaderTitles()
	local currentTeams =
		Teams:GetTeams()
	local playersMapped = {}
	local activeStats =
		getActiveStatNames()
	local orderIndex = 1
	local activeKeys = {}
	if #currentTeams > 0 then
		for _, team in ipairs(
			currentTeams
		) do
			local teamPlayers =
				team:GetPlayers()
			if #teamPlayers > 0 then
				local teamScores = {}
				for _, statName in ipairs(
					activeStats
				) do
					teamScores[statName] = 0
				end
				for _, p in ipairs(
					teamPlayers
				) do
					local pStats =
						getPlayerStatObjects(p)
					for _, stat in ipairs(
						pStats
					) do
						if (
							stat:IsA("IntValue")
							or stat:IsA("NumberValue")
						)
							and teamScores[stat.Name] then
							teamScores[stat.Name] =
								teamScores[stat.Name]
								+ stat.Value
						end
					end
				end
				local teamKey =
					"Team_" .. team.Name
				table.insert(
					activeKeys,
					teamKey
				)
				createOrUpdateRow(
					teamKey,
					team.Name,
					teamScores,
					team.TeamColor.Color,
					true,
					"",
					orderIndex
				)
				orderIndex =
					orderIndex + 1
				for _, p in ipairs(
					teamPlayers
				) do
					playersMapped[p] = true
					local pStats =
						getPlayerStatObjects(p)
					local playerStatMap = {}
					for _, stat in ipairs(
						pStats
					) do
						playerStatMap[
							stat.Name
						] = stat.Value
					end
					local playerKey =
						"Player_" .. p.Name
					table.insert(
						activeKeys,
						playerKey
					)
					createOrUpdateRow(
						playerKey,
						p.Name,
						playerStatMap,
						team.TeamColor.Color,
						false,
						"   ",
						orderIndex
					)
					orderIndex =
						orderIndex + 1
				end
			end
		end
	end
	local neutralHeaderCreated = false
	for _, p in ipairs(
		Players:GetPlayers()
	) do
		if not playersMapped[p] then
			if #currentTeams > 0
				and not neutralHeaderCreated then
				neutralHeaderCreated = true
				local neutralKey =
					"Team_Neutral"
				table.insert(
					activeKeys,
					neutralKey
				)
				createOrUpdateRow(
					neutralKey,
					"Neutral",
					{},
					Color3.fromRGB(
						230,
						230,
						230
					),
					true,
					"",
					orderIndex
				)
				orderIndex =
					orderIndex + 1
			end
			local rowColor =
				getClassicNameColor(
					p.Name
				)
			local padding =
				neutralHeaderCreated
				and "   "
				or ""
			local pStats =
				getPlayerStatObjects(p)
			local playerStatMap = {}
			for _, stat in ipairs(
				pStats
			) do
				playerStatMap[
					stat.Name
				] = stat.Value
			end
			local playerKey =
				"Player_" .. p.Name
			table.insert(
				activeKeys,
				playerKey
			)
			createOrUpdateRow(
				playerKey,
				p.Name,
				playerStatMap,
				rowColor,
				false,
				padding,
				orderIndex
			)
			orderIndex =
				orderIndex + 1
		end
	end
	for _, child in ipairs(
		ListScroll:GetChildren()
	) do
		if (
			child:IsA("Frame")
			or child:IsA("TextLabel")
		)
			and not table.find(
				activeKeys,
				child.Name
			) then
			child:Destroy()
		end
	end
end
local lastUpdate = 0
local updatePending = false
local function requestListUpdate()
	if updatePending then
		return
	end
	local now = os.clock()
	if now - lastUpdate >= 1.5 then
		lastUpdate = now
		updatePlayerList()
	else
		updatePending = true
		task.delay(
			1.5 - (now - lastUpdate),
			function()
				updatePending = false
				lastUpdate =
					os.clock()
				updatePlayerList()
			end
		)
	end
end
local function connectPlayerStats(p)
	local function hookLeaderstats(folder)
		if folder.Name ~= "leaderstats" then
			return
		end
		requestListUpdate()
		local function listenToStat(val)
			if not val:IsA("ValueBase") then
				return
			end
			storeConnection(
				val.Changed:Connect(
					function(newValue)
						local playerKey =
							"Player_" .. p.Name
						local rowFrame =
							ListScroll:
							FindFirstChild(
								playerKey
							)
						if rowFrame then
							local statContainer =
								rowFrame:
								FindFirstChild(
									"StatContainer"
								)
							local statLabel =
								statContainer
								and statContainer:
								FindFirstChild(
									val.Name
								)
							if statLabel then
								statLabel.Text =
									tostring(
										newValue
									)
							end
						end
					end
				)
			)
		end
		storeConnection(
			folder.ChildAdded:Connect(
				function(val)
					listenToStat(val)
					requestListUpdate()
				end
			)
		)
		for _, val in ipairs(
			folder:GetChildren()
		) do
			listenToStat(val)
		end
	end
	storeConnection(
		p.ChildAdded:Connect(
			hookLeaderstats
		)
	)
	local existingStats =
		p:FindFirstChild("leaderstats")
	if existingStats then
		hookLeaderstats(existingStats)
	end
	storeConnection(
		p:GetPropertyChangedSignal(
			"Team"
		):Connect(requestListUpdate)
	)
end
storeConnection(
	Players.PlayerAdded:Connect(
		function(p)
			connectPlayerStats(p)
			requestListUpdate()
		end
	)
)
