local function createClassicBubble(head, message)
	if not head or not head:IsA("BasePart") then
		return
	end

	if not message or message == "" then
		return
	end

	message = string.sub(message, 1, 124)

	local stack = getStack(head)
	local text = wrapText(message)
	local measured = measureText(text)

	local width = math.clamp(measured.X + 32, 63, MAX_TEXT_WIDTH + 32)
	local height = math.clamp(measured.Y + 22, 40, 178)

	stack.nextOrder += 1
	local order = stack.nextOrder

	local bubble = Instance.new("Frame")
	bubble.Name = "Bubble"
	bubble.BackgroundTransparency = 1
	bubble.BorderSizePixel = 0
	bubble.Size = UDim2.fromOffset(width, height + TAIL_HEIGHT - TAIL_OVERLAP)
	bubble.LayoutOrder = order
	bubble.ClipsDescendants = false
	bubble.Parent = stack.container

	local tail = Instance.new("ImageLabel")
	tail.Name = "Tail"
	tail.BackgroundTransparency = 1
	tail.BorderSizePixel = 0
	tail.Image = TAIL_IMAGE
	tail.AnchorPoint = Vector2.new(0.5, 0)
	tail.Position = UDim2.fromOffset(width / 2, height - TAIL_OVERLAP + 2)
	tail.Size = UDim2.fromOffset(TAIL_WIDTH, TAIL_HEIGHT)
	tail.ZIndex = 100 + order * 10
	tail.Parent = bubble

	local body = Instance.new("ImageLabel")
	body.Name = "Body"
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.Image = BODY_IMAGE
	body.ScaleType = Enum.ScaleType.Slice
	body.SliceCenter = Rect.new(12, 12, 52, 52)
	body.SliceScale = 1
	body.Position = UDim2.fromOffset(0, 0)
	body.Size = UDim2.fromOffset(width, height)
	body.ZIndex = 102 + order * 10
	body.Parent = bubble

	local connector = Instance.new("Frame")
	connector.Name = "TailConnector"
	connector.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	connector.BackgroundTransparency = 0
	connector.BorderSizePixel = 0
	connector.AnchorPoint = Vector2.new(0.5, 0)
	connector.Position = UDim2.fromOffset(width / 2, height + CONNECTOR_Y)
	connector.Size = UDim2.fromOffset(CONNECTOR_WIDTH, CONNECTOR_HEIGHT)
	connector.ZIndex = 104 + order * 10
	connector.Parent = bubble

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.TextSize = FONT_SIZE
	label.TextColor3 = Color3.fromRGB(0, 0, 0)
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Text = text
	label.Position = UDim2.fromOffset(11, 1)
	label.Size = UDim2.fromOffset(width - 22, height - 2)
	label.ZIndex = 103 + order * 10
	label.Parent = bubble
	apply2006Font(label, { wrapWidth = width - 22 })

	table.insert(stack.bubbles, bubble)

	task.delay(BUBBLE_LIFETIME, function()
		if bubble and bubble.Parent then
			bubble:Destroy()
		end

		for i = #stack.bubbles, 1, -1 do
			if stack.bubbles[i] == bubble then
				table.remove(stack.bubbles, i)
				break
			end
		end

		if #stack.bubbles == 0 then
			if stack.gui then
				stack.gui:Destroy()
			end
			stacks[head] = nil
		end
	end)
end

-- Smoothed RenderStepped Loop to prevent jitter/shake
storeConnection(
	RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local cameraPosition = camera.CFrame.Position

		for head, stack in pairs(stacks) do
			if not head or not head.Parent then
				if stack.gui then
					stack.gui:Destroy()
				end
				if stack.anchor then
					stack.anchor:Destroy()
				end
				stacks[head] = nil
				continue
			end

			local distance = (cameraPosition - head.Position).Magnitude
			local alpha = math.clamp((distance - CLOSE_DISTANCE) / (FAR_DISTANCE - CLOSE_DISTANCE), 0, 1)
			local targetScale = math.clamp(1 - (alpha * (1 - MIN_SCALE)), MIN_SCALE, 1)

			-- Smooth scale transitions using Lerp (12x speed multiplier) to eliminate frame-rate jitter
			stack.currentScale = stack.currentScale + (targetScale - stack.currentScale) * math.clamp(dt * 12, 0, 1)
			
			-- Deadzone threshold: ignore microscopic fractional changes that cause sub-pixel rendering jitter
			if math.abs(stack.distanceScale.Scale - stack.currentScale) > 0.005 then
				stack.distanceScale.Scale = stack.currentScale
			end
		end
	end)
)

