local function getClassicNameColor(name)
	name = tostring(name or "")
	local count = 0
	for i = 1, #name do
		count =
			count + string.byte(name, i)
	end
	return CLASSIC_CHAT_COLORS[
		(count % #CLASSIC_CHAT_COLORS) + 1
	]
end
