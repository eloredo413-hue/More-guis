-- The bubbles over NPCs are BillboardGuis: Roblox's own (in CoreGui) and the classic ones
-- the Bloxy Paradox loader draws instead. They're switched off and kept off.
local DIALOG_BUBBLE_MARKER = "Classic2006HiddenBubble"
local hiddenDialogBubbles = setmetatable({}, { __mode = "k" })

local function isDialogBubble(gui)
	local name = gui.Name
	if name == "ChatNotificationGui"
		or name == "PlayerDialogBubble"
		or string.find(name, "^ClassicExecutorDialogGui_") then
		return true
	end
	-- Roblox's bubble under some other name still has its dialog bubble pictures
	for _, child in ipairs(gui:GetDescendants()) do
		if child:IsA("ImageLabel") or child:IsA("ImageButton") then
			local image = string.lower(child.Image)
			if string.find(image, "dialog_purpose", 1, true) or string.find(image, "notify_bkg", 1, true) then
				return true
			end
		end
	end
	return false
end

local function hideDialogBubble(gui)
	if hiddenDialogBubbles[gui] or not isDialogBubble(gui) then
		return
	end
	hiddenDialogBubbles[gui] = true
	-- lets a later run with SHOW_DIALOG_BUBBLES on find it again
	pcall(gui.SetAttribute, gui, DIALOG_BUBBLE_MARKER, true)
	gui.Enabled = false
	storeConnection(gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if gui.Enabled then
			gui.Enabled = false
		end
	end))
end

-- Brings back a bubble an earlier run of this script switched off
local function showDialogBubble(gui)
	if gui:GetAttribute(DIALOG_BUBBLE_MARKER) then
		gui:SetAttribute(DIALOG_BUBBLE_MARKER, nil)
		gui.Enabled = true
	end
end

local function watchDialogBubbles(root)
	if not SHOW_DIALOG_BUBBLES then
		storeConnection(root.DescendantAdded:Connect(function(obj)
			if obj:IsA("BillboardGui") then
				-- wait a moment so the bubble is set up first
				task.defer(pcall, hideDialogBubble, obj)
			end
		end))
	end
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("BillboardGui") then
			pcall(SHOW_DIALOG_BUBBLES and showDialogBubble or hideDialogBubble, obj)
		end
	end
end

