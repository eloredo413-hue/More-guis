local BUBBLE_LIFETIME = 7.5
local MAX_DISTANCE = 130
local HEAD_OFFSET = 1.7
local FONT_SIZE = 22
local MAX_TEXT_WIDTH = 250
local CLOSE_DISTANCE = 35
local FAR_DISTANCE = 150
local MIN_SCALE = 0.65
local STACK_OVERLAP = -8
